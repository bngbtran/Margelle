rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The library belongs to the first account that signed in.
    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/library)
        && get(/databases/$(database)/documents/config/library).data.ownerUid == request.auth.uid;
    }

    // Everyone else must be invited by e-mail.
    function isInvited() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email));
    }

    function isMember() {
      return isOwner() || isInvited();
    }

    match /config/library {
      allow read: if signedIn();
      // `create` only applies while the document does not exist yet.
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /members/{email} {
      allow read: if isOwner() || (signedIn() && request.auth.token.email == email);
      allow write: if isOwner();
    }

    match /playlists/{playlistId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.ownerUid == request.auth.uid;
      // Only the person who made a playlist may change or delete it; not even
      // the library owner can touch someone else's.
      allow update: if isMember()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isMember() && resource.data.ownerUid == request.auth.uid;
    }

    match /quotes/{quoteId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.contributorUid == request.auth.uid;
      // Likewise a quote belongs to whoever contributed it, and the
      // contributor can never be rewritten.
      allow update: if isMember()
        && resource.data.contributorUid == request.auth.uid
        && request.resource.data.contributorUid == resource.data.contributorUid;
      allow delete: if isMember() && resource.data.contributorUid == request.auth.uid;
    }

    // Personal preferences, such as how each person arranged the shelf.
    match /users/{uid} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }

    // Quotes saved before playlists existed; kept so they can be migrated.
    match /users/{uid}/quotes/{quoteId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
