rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The library's owner, fixed to one Google account. Keep this in sync
    // with OWNER_EMAIL in src/lib/access.ts.
    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'tranbnb.2004@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Everyone else must be invited by e-mail.
    function isInvited() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email));
    }

    function isMember() {
      return isOwner() || isInvited();
    }

    // Only the owner can see the invitation list and invite or remove people.
    match /members/{email} {
      allow read: if isOwner() || (signedIn() && request.auth.token.email == email);
      allow write: if isOwner();
    }

    match /playlists/{playlistId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.ownerUid == request.auth.uid;
      // Only the person who made a playlist may change or delete it; not even
      // the library owner can touch someone else's.
      allow update: if isMember()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isMember() && resource.data.ownerUid == request.auth.uid;
    }

    match /quotes/{quoteId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.contributorUid == request.auth.uid;
      // Likewise a quote belongs to whoever contributed it, and the
      // contributor can never be rewritten.
      allow update: if isMember()
        && resource.data.contributorUid == request.auth.uid
        && request.resource.data.contributorUid == resource.data.contributorUid;
      allow delete: if isMember() && resource.data.contributorUid == request.auth.uid;
    }

    // Each person's profile and preferences, such as how they arranged the
    // shelf. Each person writes their own; the owner may also read everyone's (to
    // manage users) and delete them when taking someone's access away.
    match /users/{uid} {
      allow read: if isMember() && (request.auth.uid == uid || isOwner());
      allow create, update: if isMember() && request.auth.uid == uid;
      allow delete: if isMember() && (request.auth.uid == uid || isOwner());
    }

    // Quotes saved before playlists existed; kept so they can be migrated.
    match /users/{uid}/quotes/{quoteId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
